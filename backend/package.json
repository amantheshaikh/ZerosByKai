{
  "name": "zerosbykai-backend",
  "version": "1.0.0",
  "description": "ZerosByKai API - Startup ideas from Reddit",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "scrape:local": "node src/jobs/scrapers/run_scrapers.js",
    "backlog:check": "node src/jobs/backlog_check.js",
    "backlog:check:scheduled": "node src/jobs/backlog_check.js --scheduled",
    "monday:weekly": "node src/jobs/weekly.js",
    "monday:weekly:scheduled": "node src/jobs/weekly.js --scheduled",
    "schedule": "node src/jobs/schedule_newsletter.js",
    "lint": "eslint src/**",
    "test": "vitest run ./unit_tests",
    "coverage": "vitest run ./unit_tests --coverage",
    "dry-run-weekly": "node scripts/dry-run-weekly.js",
    "x:cover": "node src/jobs/generate_x_cover.js",
    "x:cards": "node src/jobs/generate_x_content.js"
  },
  "dependencies": {
    "@getbrevo/brevo": "^3.0.1",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "2.48.0",
    "algoliasearch": "^5.47.0",
    "apify-client": "^2.22.0",
    "cheerio": "^1.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.0.0",
    "nodemon": "^3.0.2",
    "playwright": "^1.58.2",
    "supertest": "^7.2.2",
    "vitest": "^4.0.18"
  }
}
